---
export interface Props {
  variant?: "default" | "tight" | "bold";
}
const { variant = "default" } = Astro.props;
---
<div class={`wordmark wm-${variant}`}>
  <span>EWSPLAT</span>
</div>

<style>
  .wordmark {
    font-family: var(--font-display, 'Bebas Neue', sans-serif);
    font-weight: 800;
    color: var(--color-text);
    display: inline-block;
  }
  .wordmark span { display: inline-block; }
  .wm-default span { /* classic – tall, normal tracking */
    font-size: clamp(2.5rem, 10vw, 4rem);
    letter-spacing: 0.02em;
  }
  .wm-tight span { /* tighter tracking, slightly condensed */
    font-size: clamp(2.8rem, 10vw, 4.2rem);
    letter-spacing: -0.01em;
  }
  .wm-bold span { /* bolder, subtle underline */
    font-size: clamp(2.5rem, 10vw, 4rem);
    letter-spacing: 0.03em;
    position: relative;
  }
  .wm-bold span::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -0.1em;
    width: 100%;
    height: 0.08em;
    background: var(--color-accent);
  }
</style>
