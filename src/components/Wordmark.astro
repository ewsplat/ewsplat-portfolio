---
export interface Props {
  variant?: "default" | "tight" | "bold";
  animated?: boolean;
  staticSrc?: string;
}
const { variant = "default", animated = false, staticSrc } = Astro.props;
---

{animated && staticSrc ? (
  <img
    src={staticSrc}
    alt=""
    class={`wordmark wm-${variant} wordmark-animated`}
    width={600}
    height={240}
    loading="eager"
    data-wordmark-nav
  />
) : (
  <div class={`wordmark wm-${variant}`}>
    <span>EWSPLAT</span>
  </div>
)}

<style>
  .wordmark-animated {
    width: auto;
    height: 100%;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .wordmark-animated {
      filter: none !important;
    }
  }
</style>
