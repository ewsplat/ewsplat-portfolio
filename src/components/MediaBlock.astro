---
import { withBase } from '../utils/site';

export interface Props {
  src?: string;
  type?: 'image' | 'gif' | 'video' | 'placeholder';
  aspect?: string;
  alt?: string;
  poster?: string;
  color?: string;
  objectFit?: 'cover' | 'contain' | 'none';
  crop?: boolean;
  controls?: boolean;
  loading?: 'lazy' | 'eager';
  response?: 'expressive' | 'tilt' | 'reveal-up' | 'reveal-side' | 'still';
}

const {
  src,
  type = 'placeholder',
  aspect,
  alt = '',
  poster,
  color = 'var(--color-surface)',
  objectFit = 'contain',
  crop = false,
  controls = true,
  loading = 'lazy',
  response = 'still',
} = Astro.props;

const fit = crop ? 'cover' : objectFit;
const mediaStyle = fit ? `object-fit: ${fit};` : '';
const effectiveAspect = aspect ?? (type === 'placeholder' ? '1/1' : undefined);
const wrapperStyle = effectiveAspect ? `aspect-ratio: ${effectiveAspect};` : undefined;
const mediaSrc = src ? withBase(src) : undefined;
const mediaPoster = poster ? withBase(poster) : undefined;
---

<div
  class:list={['media-block', { 'has-aspect': Boolean(effectiveAspect) }]}
  data-playful-media={type === 'image' || type === 'gif' ? response : undefined}
  style={wrapperStyle}
>
  {(type === 'image' || type === 'gif') && src && (
    <img
      src={mediaSrc}
      alt={alt}
      loading={loading}
      style={mediaStyle}
    />
  )}

  {type === 'video' && src && (
    <video
      src={mediaSrc}
      poster={mediaPoster}
      preload="none"
      controls={controls}
      playsinline
      aria-label={alt || 'Project video'}
      style={mediaStyle}
    >
      Your browser does not support the video tag.
    </video>
  )}

  {type === 'placeholder' && (
    <div
      class="placeholder-content"
      role="img"
      aria-label={alt || 'Placeholder media'}
      style={`background-color: ${color};`}
    />
  )}
</div>

<style>
  .media-block {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--color-surface);
  }

  .media-block:not(.has-aspect) {
    height: auto;
  }

  .media-block img,
  .media-block video {
    width: 100%;
    display: block;
  }

  .media-block.has-aspect img,
  .media-block.has-aspect video {
    height: 100%;
  }

  .media-block:not(.has-aspect) img,
  .media-block:not(.has-aspect) video {
    height: auto;
  }

  .placeholder-content {
    width: 100%;
    height: 100%;
  }
</style>
