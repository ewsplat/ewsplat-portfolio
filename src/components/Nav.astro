---
import { withBase } from '../utils/site';

const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/').replace(/\/$/, '') || '/';
---

<header class="site-header">
  <nav class="nav-container container" aria-label="Primary navigation">
    <div class="nav-left">
      <a href={withBase('/')} class="wordmark" aria-label="EWSPLAT Homepage" data-wordmark-nav>
        <img
          src="/images/wordmark/frames/frame-000.png"
          alt="EWSPLAT"
          width={200}
          height={80}
        />
      </a>
      <span class="nav-tag" aria-hidden="true">WLG // NZ</span>
    </div>

    <div class="desktop-menu">
      <ul class="nav-links">
        <li>
          <a href={withBase('/archive')} aria-current={currentPath === '/archive' ? 'page' : undefined}>
            <span class="link-label">Archive</span>
          </a>
        </li>
        <li>
          <a href={withBase('/about')} aria-current={currentPath === '/about' ? 'page' : undefined}>
            <span class="link-label">About</span>
          </a>
        </li>
        <li>
          <a href={withBase('/contact')} aria-current={currentPath === '/contact' ? 'page' : undefined}>
            <span class="link-label">Contact</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="mobile-menu">
      <details class="mobile-nav-details">
        <summary aria-label="Toggle navigation menu" class="menu-toggle">
          <svg class="hamburger-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </summary>
        <div class="mobile-dropdown">
          <ul class="mobile-links">
            <li><a href={withBase('/archive')} aria-current={currentPath === '/archive' ? 'page' : undefined}>Archive</a></li>
            <li><a href={withBase('/about')} aria-current={currentPath === '/about' ? 'page' : undefined}>About</a></li>
            <li><a href={withBase('/contact')} aria-current={currentPath === '/contact' ? 'page' : undefined}>Contact</a></li>
          </ul>
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(8px);
    background-color: rgba(246, 246, 244, 0.94);
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.75rem;
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .wordmark {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 1.75rem;
    max-height: 1.75rem;
    text-decoration: none;
    line-height: 1;
    overflow: hidden;
  }

  .wordmark img {
    height: 1.75rem;
    width: auto;
    display: block;
    user-select: none;
    pointer-events: auto;
  }

  .nav-tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    line-height: 1;
  }

  /* Desktop navigation links */
  .desktop-menu {
    display: flex;
    align-items: center;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
    padding: 0.35rem 0.2rem;
    transition: color 0.16s ease, transform 0.16s ease;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .nav-idx {
    font-size: 0.5625rem;
    color: var(--color-muted);
    opacity: 0.6;
    transition: color 0.16s ease, opacity 0.16s ease;
  }

  .nav-links a:hover .nav-idx,
  .nav-links a:focus-visible .nav-idx,
  .nav-links a[aria-current='page'] .nav-idx {
    color: var(--color-accent);
    opacity: 1;
  }

  .nav-links a::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--color-accent);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: var(--color-accent);
  }

  .nav-links a:hover::after,
  .nav-links a:focus-visible::after,
  .nav-links a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav-links a[aria-current='page'] {
    color: var(--color-accent);
  }

  /* Mobile navigation */
  .mobile-menu {
    display: none;
  }

  .mobile-nav-details {
    position: relative;
  }

  .mobile-nav-details summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 0.4rem 0.55rem;
    color: var(--color-text);
  }

  .mobile-nav-details summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav-details summary:hover,
  .mobile-nav-details summary:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .mobile-dropdown {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    min-width: 170px;
    padding: 0.75rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .mobile-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mobile-links a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
    padding: 0.25rem 0.5rem;
    display: block;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .mobile-links a:hover,
  .mobile-links a[aria-current='page'] {
    background-color: var(--color-bg);
    color: var(--color-accent);
  }

  @media (max-width: 639px) {
    .desktop-menu {
      display: none;
    }
    .mobile-menu {
      display: flex;
      align-items: center;
    }
    .nav-tag {
      display: none;
    }
  }
</style>
