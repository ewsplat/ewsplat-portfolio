---
import { withBase } from '../utils/site';

export interface Props {
  href: string;
  src: string;
  alt: string;
  name: string;
  collection: string;
}

const { href, src, alt, name, collection } = Astro.props;
---

<a class="character-cameo" href={href} aria-label={`View ${name}`}>
  <span class="cameo-image">
    <img src={withBase(src)} alt={alt} loading="lazy" decoding="async" />
  </span>
  <span class="cameo-caption">
    <span class="cameo-name">{name}<span aria-hidden="true">↗</span></span>
    <span class="cameo-collection">{collection}</span>
  </span>
</a>

<style>
  .character-cameo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    color: var(--color-text);
    text-align: left;
  }

  .cameo-image {
    flex: 0 0 auto;
    width: 3.1rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transform-origin: 50% 80%;
    transition: border-color 180ms ease, transform 220ms cubic-bezier(0.2, 0.65, 0.3, 1);
  }

  .cameo-image img {
    width: 100%;
    height: auto;
  }

  .cameo-caption {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .cameo-name {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
    line-height: 0.95;
    text-transform: uppercase;
    transition: color 160ms ease;
  }

  .cameo-name span {
    color: var(--color-accent);
    font-family: var(--font-body);
    font-size: 0.7rem;
    transition: transform 160ms ease;
  }

  .cameo-collection {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .character-cameo:focus-visible .cameo-image {
    border-color: var(--color-accent);
    transform: translateY(-0.15rem) rotate(-2deg);
  }

  .character-cameo:focus-visible .cameo-name {
    color: var(--color-accent);
  }

  .character-cameo:focus-visible .cameo-name span {
    transform: translate(0.1rem, -0.1rem);
  }

  @media (hover: hover) {
    .character-cameo:hover .cameo-image {
      border-color: var(--color-accent);
      transform: translateY(-0.15rem) rotate(-2deg);
    }

    .character-cameo:hover .cameo-name {
      color: var(--color-accent);
    }

    .character-cameo:hover .cameo-name span {
      transform: translate(0.1rem, -0.1rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .character-cameo:focus-visible .cameo-image,
    .character-cameo:hover .cameo-image,
    .character-cameo:focus-visible .cameo-name span,
    .character-cameo:hover .cameo-name span {
      transform: none;
    }
  }
</style>
