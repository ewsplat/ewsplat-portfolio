---
import { withBase } from '../utils/site';
---

<footer class="site-footer">
  <div class="footer-container container">
    <div class="footer-meta-block">
      <a href={withBase('/')} class="footer-brand" aria-label="EWSPLAT Homepage" data-wordmark-footer>
        <img
          src={withBase('/images/wordmark/frames/frame-000.png')}
          alt="EWSPLAT"
          width={200}
          height={80}
        />
      </a>
      <span class="footer-tag">INDEPENDENT VISUAL PRACTICE // WLG NZ</span>
    </div>

    <div class="footer-disciplines">
      <span>ILLUSTRATION</span>
      <span>•</span>
      <span>CHARACTER DESIGN</span>
      <span>•</span>
      <span>ANIMATION</span>
      <span>•</span>
      <span>GRAPHIC DESIGN</span>
    </div>

    <div class="footer-links">
      <a href={withBase('/archive')}>ARCHIVE</a>
      <a href={withBase('/about')}>ABOUT</a>
      <a href={withBase('/contact')}>CONTACT</a>
      <a href="https://www.instagram.com/ewsplat_/" target="_blank" rel="noopener noreferrer">INSTAGRAM</a>
      <a href="#main-content" class="top-anchor">Back to top</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background-color: var(--color-surface);
    padding: 2rem 0;
    margin-top: auto;
  }

  .footer-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    width: 100%;
    max-width: 1600px;
    padding-right: clamp(1.5rem, 3vw, 3rem);
    padding-left: clamp(1.5rem, 3vw, 3rem);
  }

  .footer-meta-block {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    height: 1.75rem;
    overflow: hidden;
    line-height: 1;
  }

  .footer-brand img {
    display: block;
    width: auto;
    height: 1.75rem;
    user-select: none;
  }

  .footer-tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .footer-disciplines {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
  }

  .footer-links a {
    color: var(--color-text);
    transition: color 0.15s ease;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--color-accent);
  }

  .top-anchor {
    color: var(--color-accent) !important;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .footer-container {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .footer-disciplines {
      display: none;
    }
  }
</style>
