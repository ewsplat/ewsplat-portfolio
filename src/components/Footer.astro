---
import { withBase } from '../utils/site';
---

<footer class="site-footer">
  <div class="footer-container container">
    <div class="footer-meta-block">
      <span class="footer-brand">EWSPLAT</span>
      <span class="footer-tag">INDEPENDENT VISUAL PRACTICE // WLG NZ</span>
    </div>

    <div class="footer-disciplines">
      <span>ILLUSTRATION</span>
      <span>•</span>
      <span>CHARACTER DESIGN</span>
      <span>•</span>
      <span>ANIMATION</span>
      <span>•</span>
      <span>GRAPHIC DESIGN</span>
    </div>

    <div class="footer-links">
      <a href={withBase('/archive')}>ARCHIVE</a>
      <a href={withBase('/about')}>ABOUT</a>
      <a href={withBase('/contact')}>CONTACT</a>
      <a href="#main-content" class="top-anchor">Back to top</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background-color: var(--color-surface);
    padding: 2rem 0;
    margin-top: auto;
  }

  .footer-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-meta-block {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .footer-brand {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--color-text);
  }

  .footer-tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .footer-disciplines {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
  }

  .footer-links a {
    color: var(--color-text);
    transition: color 0.15s ease;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--color-accent);
  }

  .top-anchor {
    color: var(--color-accent) !important;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .footer-container {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .footer-disciplines {
      display: none;
    }
  }
</style>
