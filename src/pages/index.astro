---
import Layout from '../layouts/Layout.astro';
import MediaBlock from '../components/MediaBlock.astro';
import ArchivePortal from '../components/ArchivePortal.astro';
import { withBase } from '../utils/site';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const publishedProjects = allProjects
  .filter((p) => !p.data.draft && !p.data.compositionTest && !p.data.placeholder)
  .sort((a, b) => (a.data.archiveOrder ?? a.data.featuredOrder ?? 99) - (b.data.archiveOrder ?? b.data.featuredOrder ?? 99));

const totalPublishedCount = publishedProjects.length;

// Select homepage featured projects ordered by homepageOrder
const homepageProjects = publishedProjects
  .filter((p) => p.data.homepageFeatured === true)
  .sort((a, b) => (a.data.homepageOrder ?? 99) - (b.data.homepageOrder ?? 99));

const homepageSocialImage = homepageProjects[0]?.data.thumbnail?.src ?? homepageProjects[0]?.data.hero?.src;

const projectHref = (project: any) =>
  withBase(`/projects/${project?.data?.slug ?? project?.id}`);

const getRoles = (project: any) => {
  const roles = project?.data?.roles;
  return Array.isArray(roles) && roles.length > 0 ? roles.join(', ') : '';
};

const getClient = (project: any) => project?.data?.client;

// Editorial moment mapping: explicit dominant/secondary relationships per moment.
// Asymmetry comes from scale, alignment and negative space — not arbitrary overlap.
const momentPlan = [
  { dominant: 0, secondary: 1, ratio: '8/4', secondaryOffset: 'lower' },
  { dominant: 2, secondary: 3, ratio: '7/5', secondaryOffset: 'middle' },
  { dominant: 4, secondary: 5, ratio: '6/6', secondaryOffset: 'middle' },
  { dominant: 6, secondary: 8, ratio: '6/6', secondaryOffset: 'aligned' },
  { dominant: 7, ratio: 'standalone' },
];

// Curated archive portal items: published projects that are NOT homepage-featured.
// These become the kinetic fragments of the archive gateway.
const portalProjectSlugs = [
  'deepstate-rain',
  'digital-farming-fence',
  'how-we-can-be-bella-claxton',
  'personal-morphing-characters',
  'personal-sour-yuck',
  'iloveugly-product-illustration',
  'flux-eden-burns-event-artwork',
  'kaylee-bell-cowboy-up',
  'spinoff-nz-web-illustrations',
  'ewsplat-motion-experiments',
];

interface PortalMedia {
  type?: 'image' | 'gif' | 'video' | 'placeholder' | 'youtube';
  src?: string;
  poster?: string;
  aspect?: string;
  alt?: string;
}

interface PortalItem {
  slug: string;
  title: string;
  discipline?: string;
  year?: string;
  media: PortalMedia;
}

const portalPublished = publishedProjects.filter((p) => p.data.homepageFeatured !== true);
const portalItems: PortalItem[] = portalProjectSlugs
  .map((slug) => {
    const project = portalPublished.find((p) => p.data.slug === slug);
    if (!project) return null;
    const thumb = project.data.thumbnail;
    return {
      slug: project.data.slug,
      title: project.data.title,
      discipline: project.data.discipline,
      year: project.data.year ?? '',
      media: {
        type: thumb?.type ?? 'image',
        src: thumb?.src,
        poster: thumb?.poster,
        aspect: thumb?.aspect ?? '4/3',
        alt: thumb?.alt ?? project.data.title,
      },
    } as PortalItem;
  })
  .filter((item): item is PortalItem => item !== null);
---

<Layout title="EWSPLAT — Illustration, Character Design & Motion" description="Nic Little's independent creative practice in Wellington, illustration, character design, animation and graphic design.">
  <div class="container home-page" data-home-interaction>

    <!-- MASTHEAD -->
    <header class="home-masthead" aria-label="EWSPLAT creative practice introduction">
      <div class="masthead-headline-wrap">
        <span class="home-eyebrow">EWSPLAT / INDEPENDENT CREATIVE PRACTICE / WLG—NZ</span>
        <h1 class="masthead-title">
          <span class="headline-line">ILLUSTRATION,<br>CHARACTER DESIGN,<br>ANIMATION +<br>GRAPHIC DESIGN.</span>
        </h1>
      </div>
    </header>

    <!-- HOMEPAGE: Editorial moment sequence -->
    <main class="home-moments" aria-label="Featured projects">
      {momentPlan.map((moment, momentIndex) => {
        const domProject = homepageProjects[moment.dominant];
        const secProject = moment.secondary !== undefined ? homepageProjects[moment.secondary] : null;
        return (
          <section
            class={`home-moment home-moment--${moment.ratio.replace(/\//, '-')} ${moment.secondaryOffset ? `home-moment--offset-${moment.secondaryOffset}` : ''}`}
            data-moment={momentIndex + 1}
          >
            <article data-project-slug={domProject.data.slug}>
              <a
                href={projectHref(domProject)}
                class="moment-link"
                aria-label={`View ${domProject.data.title}`}
              >
                {(() => {
                  const isStandalone = moment.ratio === 'standalone';
                  const thumbnail = domProject.data.thumbnail;
                  const isVideo = thumbnail?.type === 'video' || thumbnail?.type === 'youtube';
                  const discipline = domProject.data.discipline || 'mixed';
                  const roles = getRoles(domProject);
                  const client = getClient(domProject);
                  return (
                    <div class={`project-card project-card--${isStandalone ? 'standalone' : 'dominant'}`}>
                    <div class="project-card-media">
                      {thumbnail && (
                        <MediaBlock
                          type={thumbnail.type}
                          src={thumbnail.src}
                          aspect={thumbnail.aspect}
                          color={thumbnail.color}
                          alt={thumbnail.alt || domProject.data.title}
                          poster={thumbnail.poster}
                          videoId={thumbnail.videoId}
                          controls={false}
                          loading="eager"
                          response="expressive"
                          tiltIntensity="medium"
                        />
                      )}
                    </div>
                    <div class="project-card-caption">
                      <div class="project-discipline">{discipline}</div>
                      <h2 class="project-title"><span>{domProject.data.title}</span></h2>
                      <p class="project-meta">
                        {roles && <span class="project-roles">{roles}</span>}
                        {client && <span class="project-context">— {client}</span>}
                      </p>
                      <span class="project-view">View project →</span>
                    </div>
                  </div>
                );
              })()}
            </a>
            </article>
{momentIndex === 0 && (
              <div class="yuck-wrapper">
                <a href={withBase('/projects/personal-sour-yuck')} class="yuck-link" aria-label="View Sour Yuck! — Personal Work">
                <div class="yuck-accent">
                  <MediaBlock
                    type="image"
                    src="/images/portfolio/web/PersonalWorks/SourYuck!.webp"
                    aspect="4/3"
                    alt="Sour Yuck character accent"
                    controls={false}
                    loading="eager"
                    response="still"
                    tiltIntensity="subtle"
                  />
                </div>
                <span class="yuck-label"><strong>SOUR YUCK!</strong><small>PERSONAL WORK</small></span>
                </a>
              </div>
            )}
            {secProject && (
              <article data-project-slug={secProject.data.slug}>
              <a
                href={projectHref(secProject)}
                class="moment-link"
                aria-label={`View ${secProject.data.title}`}
              >
                {(() => {
                  const thumbnail = secProject.data.thumbnail;
                  const isVideo = thumbnail?.type === 'video' || thumbnail?.type === 'youtube';
                  const discipline = secProject.data.discipline || 'mixed';
                  const roles = getRoles(secProject);
                  const client = getClient(secProject);
                  return (
                    <div class="project-card project-card--secondary">
                      <div class="project-card-media">
                        {thumbnail && (
                          <MediaBlock
                            type={thumbnail.type}
                            src={thumbnail.src}
                            aspect={thumbnail.aspect}
                            color={thumbnail.color}
                            alt={thumbnail.alt || secProject.data.title}
                            poster={thumbnail.poster}
                            videoId={thumbnail.videoId}
                            controls={false}
                            loading="eager"
                            response={isVideo ? 'tilt' : 'reveal'}
                            tiltIntensity="subtle"
                          />
                        )}
                      </div>
                      <div class="project-card-caption">
                        <div class="project-discipline">{discipline}</div>
                        <h2 class="project-title"><span>{secProject.data.title}</span></h2>
                        <p class="project-meta">
                          {roles && <span class="project-roles">{roles}</span>}
                          {client && <span class="project-context">— {client}</span>}
                        </p>
                        <span class="project-view">View project →</span>
                      </div>
                    </div>
                  );
                })()}
              </a>
              </article>
            )}
          </section>
        );
      })}
    </main>

    <!-- ARCHIVE GATEWAY: kinetic orbital archive -->
    <ArchivePortal
      items={portalItems}
      totalPublishedCount={totalPublishedCount}
    />

  </div>
</Layout>

<style>
  /* ==========================================================================
     HOME PAGE BASE
     ========================================================================== */
  .home-page {
    padding-bottom: clamp(3rem, 6vw, 5rem);
    /* Homepage-specific: wider visual stage on desktop than the global container,
       scoped to the homepage only so project pages remain unchanged. */
    width: 100%;
    max-width: none;
    margin: 0 auto;
    padding-left: clamp(1.5rem, 3vw, 3rem);
    padding-right: clamp(1.5rem, 3vw, 3rem);
    overflow-x: clip;
  }

  @media (min-width: 1440px) {
    .home-page {
      max-width: 1600px;
    }
  }

  /* MASTHEAD */
  .home-masthead {
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .home-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.5rem;
    line-height: 1;
  }

  .masthead-headline-wrap {
    display: block;
  }

  .headline-line {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 1;
    display: inline-block;
    white-space: pre-line;
    color: var(--color-text);
    font-size: clamp(3rem, 6vw, 4.5rem);
  }

  .masthead-title {
    margin: 0;
  }

  /* HOME MOMENTS: editorial sequence of paired moments.
     Asymmetry comes from scale, alignment and negative space — not arbitrary overlap. */
  .home-moments {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 4rem);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .home-moment {
    position: relative;
    display: grid;
    align-items: start;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .home-moment--offset-lower {
    align-items: end;
  }

  .home-moment--offset-lower .moment-link:nth-child(2) {
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .home-moment--offset-middle .moment-link:nth-child(2) {
    padding-top: clamp(1rem, 3vw, 2rem);
  }

  /* YUCK accent - small intentional overlap on Orange Fields moment */
  .yuck-wrapper {
    position: absolute;
    left: min(61%, 42rem);
    top: 54%;
    width: clamp(88px, 11vw, 150px);
    aspect-ratio: 1;
    overflow: visible;
    z-index: 25;
  }

  .yuck-accent {
    position: absolute;
    inset: 0;
    width: 100%;
    height: auto;
    z-index: 25;
    transition: transform 180ms ease;
  }

  .yuck-accent :global(.media-block) {
    background: transparent;
    width: 100%;
    height: auto;
  }

  .yuck-accent :global(.media-block img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .yuck-link { position: relative; display: block; color: inherit; text-decoration: none; }
  .yuck-label {
    position: absolute; left: 0; bottom: -2.1rem; display: flex; flex-direction: column;
    gap: 0.15rem; opacity: 0; color: var(--color-text); font-family: var(--font-mono);
    font-size: 0.5rem; letter-spacing: 0.06em; text-transform: uppercase; transition: opacity 160ms ease;
  }
  .yuck-label small { color: var(--color-muted); font-size: inherit; }
  @media (hover: hover) {
    .yuck-link:hover .yuck-accent, .yuck-link:focus-visible .yuck-accent { transform: rotate(2deg) scale(1.04); }
    .yuck-link:hover .yuck-label, .yuck-link:focus-visible .yuck-label { opacity: 1; }
  }

  .moment-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-card--dominant .project-card-media {
    width: 100%;
    overflow: hidden;
  }

  .project-card--dominant .project-card-media :global(.media-block) {
    background: transparent;
    width: 100%;
    height: auto;
  }

  .project-card--dominant .project-card-media :global(.media-block img),
  .project-card--dominant .project-card-media :global(.media-block video),
  .project-card--dominant .project-card-media :global(.media-block iframe) {
    object-fit: cover;
    width: 100%;
    height: auto;
    display: block;
  }

  .project-card--secondary {
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .project-card--secondary .project-card-media {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .project-card--secondary .project-card-media :global(.media-block) {
    background: transparent;
    width: 100%;
    height: 100%;
  }

  .project-card--secondary .project-card-media :global(.media-block img),
  .project-card--secondary .project-card-media :global(.media-block video),
  .project-card--secondary .project-card-media :global(.media-block iframe) {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  .project-card--standalone {
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .project-card--standalone .project-card-media {
    width: 100%;
    overflow: hidden;
  }

  .project-card--standalone .project-card-media :global(.media-block) {
    background: transparent;
    width: 100%;
    height: auto;
  }

  .project-card--standalone .project-card-media :global(.media-block img),
  .project-card--standalone .project-card-media :global(.media-block video),
  .project-card--standalone .project-card-media :global(.media-block iframe) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  /* Fix: allow aspect-ratio to drive media height so no empty grey area shows */
  .project-card--standalone .project-card-media :global(.media-block.has-aspect) {
    aspect-ratio: var(--aspect-ratio, 4 / 3);
  }

  .project-card--standalone .project-card-media :global(.media-block.has-aspect) img,
  .project-card--standalone .project-card-media :global(.media-block.has-aspect) video {
    height: 100%;
  }

  .project-card-caption {
    padding: clamp(0.65rem, 1.2vw, 0.9rem) clamp(1rem, 2vw, 1.25rem);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .project-discipline {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .project-title {
    font-family: var(--font-headline);
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .project-title span {
    display: block;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.3rem;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.03em;
    color: var(--color-muted);
    margin-top: 0.15rem;
  }

  .project-roles {
    color: var(--color-text);
    font-weight: 500;
  }

  .project-context {
    color: var(--color-muted);
    opacity: 0.8;
  }

  .project-view {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-text);
    padding-bottom: 0.05rem;
    margin-top: 0.25rem;
    transition: color 0.16s ease, border-color 0.16s ease;
    width: fit-content;
  }

  .project-view:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .yuck-accent, .yuck-label { transition: none; }
    .project-card--secondary,
    .project-card--standalone {
      transition: none;
    }
  }

  @media (hover: none) {
    .project-card--secondary:active,
    .project-card--standalone:active {
      border-color: var(--color-accent);
    }
  }

  /* Moment 1 — 8 / 4 */
  .home-moment--8-4 {
    grid-template-columns: 8fr 4fr;
  }

  .home-moment--offset-lower .moment-link:nth-child(2) {
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  /* Moment 2 — 7 / 5 */
  .home-moment--7-5 {
    grid-template-columns: 7fr 5fr;
  }

  /* Moment 3 — 6 / 6 */
  .home-moment--6-6 {
    grid-template-columns: 6fr 6fr;
  }

  /* Moment 4 — 6 / 6 */
  .home-moment--6-6[data-moment="4"] {
    grid-template-columns: 6fr 6fr;
  }

  /* Moment 5 — standalone */
  .home-moment--standalone {
    grid-template-columns: 1fr;
  }

  .home-moment--standalone .project-card--standalone .project-card-caption {
    padding-top: clamp(1rem, 2vw, 1.5rem);
  }

  /* ==========================================================================
     ARCHIVE CLUSTER GATEWAY
     ========================================================================== */
  .archive-cluster {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .cluster-link {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 0;
  }

  .cluster-field {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    overflow: hidden;
  }

  .cluster-link:hover .cluster-field {
    border-color: var(--color-accent);
    box-shadow: 0 12px 40px -12px rgba(0, 0, 0, 0.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .cluster-link:hover .cluster-field {
      box-shadow: none;
    }
  }

  @media (hover: none) {
    .cluster-link:hover .cluster-field {
      border-color: var(--color-border);
      box-shadow: none;
    }

    .cluster-link:active .cluster-field {
      border-color: var(--color-accent);
    }
  }

  /* Fragment Base */
  .cluster-fragment {
    position: absolute;
    overflow: hidden;
    background-color: var(--color-surface-pure);
    border: 1px solid var(--color-border);
    transition: transform 0.3s cubic-bezier(0.2, 0.65, 0.3, 1),
                box-shadow 0.3s cubic-bezier(0.2, 0.65, 0.3, 1),
                border-color 0.2s ease,
                z-index 0s;
  }

  .cluster-fragment :global(.media-block) {
    background: transparent;
    width: 100%;
    height: 100%;
  }

  .cluster-fragment :global(.media-block img),
  .cluster-fragment :global(.media-block video) {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  /* Fragment Sizing */
  .cluster-fragment--cinematic {
    width: 42%;
    aspect-ratio: 21 / 9;
  }

  .cluster-fragment--large {
    width: 36%;
    aspect-ratio: 16 / 9;
  }

  .cluster-fragment--medium {
    width: 26%;
    aspect-ratio: 4 / 3;
  }

  .cluster-fragment--portrait {
    width: 20%;
    aspect-ratio: 3 / 4;
  }

  .cluster-fragment--square {
    width: 22%;
    aspect-ratio: 1 / 1;
  }

  .cluster-fragment--small {
    width: 18%;
    aspect-ratio: 1 / 1;
  }

  /* Fragment positioning - carefully composed arrangement with visual rhythm */
  /* Primary anchors: cinematic top-left, large bottom-right */
  .cluster-fragment[data-fragment-type="primary"][style*="--fragment-index: 0"] {
    top: 3%;
    left: 2%;
    z-index: 10;
  }

  .cluster-fragment[data-fragment-type="primary"][style*="--fragment-index: 1"] {
    bottom: 3%;
    right: 2%;
    z-index: 10;
  }

  /* Secondary: bridging fragments creating visual connections */
  .cluster-fragment[data-fragment-type="secondary"][style*="--fragment-index: 2"] {
    top: 16%;
    right: 3%;
    z-index: 8;
  }

  .cluster-fragment[data-fragment-type="secondary"][style*="--fragment-index: 3"] {
    top: 50%;
    left: 2%;
    z-index: 7;
    transform: translateY(-50%);
  }

  .cluster-fragment[data-fragment-type="secondary"][style*="--fragment-index: 4"] {
    bottom: 16%;
    left: 3%;
    z-index: 8;
  }

  /* Tertiary: detail fragments adding texture and counterpoint */
  .cluster-fragment[data-fragment-type="tertiary"][style*="--fragment-index: 5"] {
    top: 7%;
    left: 46%;
    z-index: 5;
  }

  .cluster-fragment[data-fragment-type="tertiary"][style*="--fragment-index: 6"] {
    top: 30%;
    right: 28%;
    z-index: 5;
  }

  .cluster-fragment[data-fragment-type="tertiary"][style*="--fragment-index: 7"] {
    top: 53%;
    right: 10%;
    z-index: 5;
  }

  .cluster-fragment[data-fragment-type="tertiary"][style*="--fragment-index: 8"] {
    bottom: 10%;
    left: 30%;
    z-index: 5;
  }

  .cluster-fragment[data-fragment-type="tertiary"][style*="--fragment-index: 9"] {
    bottom: 26%;
    right: 18%;
    z-index: 5;
  }

  /* Hover interactions on fragments */
  @media (hover: hover) {
    .cluster-link:hover .cluster-fragment {
      border-color: var(--color-border);
    }

    .cluster-fragment:hover {
      z-index: 20 !important;
      border-color: var(--color-accent);
      box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.4);
      transform: scale(1.02);
    }
  }

  /* Central invitation */
  .cluster-invitation {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 1.25rem 2rem;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    z-index: 15;
    text-align: center;
    pointer-events: none;
    opacity: 0.95;
    transition: opacity 0.2s ease, border-color 0.2s ease, transform 0.3s cubic-bezier(0.2, 0.65, 0.3, 1);
  }

  .cluster-link:hover .cluster-invitation {
    border-color: var(--color-accent);
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.02);
  }

  .invitation-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
