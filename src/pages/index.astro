---
import Layout from '../layouts/Layout.astro';
import MediaBlock from '../components/MediaBlock.astro';
import { withBase } from '../utils/site';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => !p.data.draft && p.data.featured)
  .sort((a, b) => (a.data.featuredOrder ?? 99) - (b.data.featuredOrder ?? 99));

const dominantProject = featuredProjects[0];
const supportProject1 = featuredProjects[1];
const supportProject2 = featuredProjects[2];
const continuationProjects = featuredProjects.slice(3, 7);

const projectHref = (project: (typeof featuredProjects)[number]) =>
  withBase(`/projects/${project.data.slug ?? project.id}`);
---

<Layout title="EWSPLAT — Multidisciplinary Creative Practice">
  <div class="container">
    <section class="hero" aria-label="Introduction">
      <div class="hero-eyebrow">
        <span>Independent creative practice</span>
        <span>Image / motion / other things</span>
      </div>
      <h1 class="hero-title">EWSPLAT</h1>
      <div class="hero-bottom">
        <p class="hero-intro">Images, characters and worlds — still and moving.</p>
        <p class="hero-note">Illustration, animation, design, 2D / 3D and visual experiments.</p>
      </div>
      <hr class="hero-rule" />
    </section>

    <section class="selected-work" aria-label="Selected Work">
      <div class="section-heading">
        <span>01 — Selected work</span>
        <span>Some things, for now</span>
      </div>
      <div class="selected-work-grid">
        {dominantProject && (
          <div class="dominant-col">
            <a href={projectHref(dominantProject)} class="project-card" aria-label={`View ${dominantProject.data.title}`}>
              {dominantProject.data.thumbnail && (
                <MediaBlock
                  type={dominantProject.data.thumbnail.type}
                  src={dominantProject.data.thumbnail.src}
                  aspect={dominantProject.data.thumbnail.aspect}
                  color={dominantProject.data.thumbnail.color}
                  alt={dominantProject.data.thumbnail.alt || dominantProject.data.title}
                  poster={dominantProject.data.thumbnail.poster}
                  crop={dominantProject.data.thumbnail.crop}
                  controls={false}
                />
              )}
              <div class="project-info">
                <span class="project-title">{dominantProject.data.title}</span>
                {dominantProject.data.roles.length > 0 && (
                  <span class="project-roles">{dominantProject.data.roles.join(' / ')}</span>
                )}
              </div>
            </a>
          </div>
        )}

        <div class="support-col">
          <div class="annotation"><span>Across disciplines</span><span aria-hidden="true">↘</span></div>
          <div class="support-items">
            {supportProject1 && (
              <a href={projectHref(supportProject1)} class="project-card" aria-label={`View ${supportProject1.data.title}`}>
                {supportProject1.data.thumbnail && (
                  <MediaBlock
                    type={supportProject1.data.thumbnail.type}
                    src={supportProject1.data.thumbnail.src}
                    aspect={supportProject1.data.thumbnail.aspect}
                    color={supportProject1.data.thumbnail.color}
                    alt={supportProject1.data.thumbnail.alt || supportProject1.data.title}
                    poster={supportProject1.data.thumbnail.poster}
                    crop={supportProject1.data.thumbnail.crop}
                    controls={false}
                  />
                )}
                <div class="project-info">
                  <span class="project-title">{supportProject1.data.title}</span>
                  {supportProject1.data.roles.length > 0 && (
                    <span class="project-roles">{supportProject1.data.roles.join(' / ')}</span>
                  )}
                </div>
              </a>
            )}
            {supportProject2 && (
              <a href={projectHref(supportProject2)} class="project-card" aria-label={`View ${supportProject2.data.title}`}>
                {supportProject2.data.thumbnail && (
                  <MediaBlock
                    type={supportProject2.data.thumbnail.type}
                    src={supportProject2.data.thumbnail.src}
                    aspect={supportProject2.data.thumbnail.aspect}
                    color={supportProject2.data.thumbnail.color}
                    alt={supportProject2.data.thumbnail.alt || supportProject2.data.title}
                    poster={supportProject2.data.thumbnail.poster}
                    crop={supportProject2.data.thumbnail.crop}
                    controls={false}
                  />
                )}
                <div class="project-info">
                  <span class="project-title">{supportProject2.data.title}</span>
                  {supportProject2.data.roles.length > 0 && (
                    <span class="project-roles">{supportProject2.data.roles.join(' / ')}</span>
                  )}
                </div>
              </a>
            )}
          </div>
        </div>
      </div>

      {continuationProjects.length > 0 && (
        <div class="featured-continuation" aria-label="More selected work">
          {continuationProjects.map((project) => (
            <a
              href={projectHref(project)}
              class:list={['project-card', `featured-card-${project.data.featuredOrder}`]}
              aria-label={`View ${project.data.title}`}
            >
              {project.data.thumbnail && (
                <MediaBlock
                  type={project.data.thumbnail.type}
                  src={project.data.thumbnail.src}
                  aspect={project.data.thumbnail.aspect}
                  color={project.data.thumbnail.color}
                  alt={project.data.thumbnail.alt || project.data.title}
                  poster={project.data.thumbnail.poster}
                  crop={project.data.thumbnail.crop}
                  controls={false}
                />
              )}
              <div class="project-info">
                <span class="project-title">{project.data.title}</span>
                {project.data.roles.length > 0 && (
                  <span class="project-roles">{project.data.roles.join(' / ')}</span>
                )}
              </div>
            </a>
          ))}
        </div>
      )}
    </section>

    <section class="archive-section" aria-label="Continue to the archive">
      <hr class="archive-rule" />
      <div class="archive-link-wrapper">
        <p class="archive-prompt">There’s more where that came from.</p>
        <a href={withBase('/archive')} class="archive-link"><span>Open the index</span><span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .hero {
    padding: clamp(3.5rem, 8vw, 7rem) 0 1.5rem;
    position: relative;
  }

  .hero-eyebrow,
  .hero-bottom,
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
  }

  .hero-eyebrow,
  .section-heading {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero-eyebrow {
    margin-bottom: 0.75rem;
    color: var(--color-muted);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(6rem, 17.2vw, 13rem);
    line-height: 0.76;
    letter-spacing: -0.035em;
    margin: 0 -0.045em 1.5rem;
    white-space: nowrap;
  }

  .hero-intro {
    font-family: var(--font-body);
    font-size: clamp(1.35rem, 2.8vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    max-width: 27rem;
    line-height: 1.15;
  }

  .hero-note {
    max-width: 17rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
    text-align: right;
  }

  .hero-rule {
    border: none;
    border-bottom: 1px solid var(--color-accent);
    margin-top: 2rem;
    margin-bottom: 3.25rem;
  }

  .selected-work {
    margin-bottom: 2rem;
  }

  .section-heading {
    padding-bottom: 0.75rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .section-heading span:first-child {
    color: var(--color-accent);
  }

  .selected-work-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.28fr) minmax(18rem, 0.72fr);
    gap: clamp(1.75rem, 5vw, 5rem);
    align-items: start;
  }

  .dominant-col {
    display: flex;
    flex-direction: column;
  }

  .support-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1.5rem;
  }

  .annotation {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-muted);
  }

  .annotation span:last-child {
    color: var(--color-accent);
    font-size: 1.25rem;
  }

  .support-items {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
    padding-top: 0.5rem;
  }

  .featured-continuation {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2.5rem, 7vw, 6rem) clamp(1rem, 3vw, 2.5rem);
    align-items: start;
    margin-top: clamp(3rem, 8vw, 7rem);
  }

  .featured-card-4 {
    grid-column: 1 / span 7;
  }

  .featured-card-5 {
    grid-column: 9 / span 4;
    margin-top: clamp(3rem, 9vw, 7rem);
  }

  .featured-card-6 {
    grid-column: 2 / span 5;
  }

  .featured-card-7 {
    grid-column: 8 / span 5;
    margin-top: clamp(2rem, 6vw, 5rem);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    text-decoration: none;
    color: inherit;
  }

  .project-card:hover .project-title {
    color: var(--color-accent);
  }

  .project-card:focus-visible .project-title {
    color: var(--color-accent);
  }

  .project-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .project-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    line-height: 0.95;
    color: var(--color-text);
    transition: color 0.15s ease;
  }

  .project-roles {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .archive-section {
    margin-top: clamp(3rem, 8vw, 7rem);
    margin-bottom: 4rem;
  }

  .archive-rule {
    border: none;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.25rem;
  }

  .archive-link-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .archive-prompt {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.7vw, 1.35rem);
    letter-spacing: -0.035em;
  }

  .archive-link {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-accent);
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    text-transform: uppercase;
    transition: color 0.15s ease, gap 0.15s ease;
  }

  .archive-link:hover {
    color: var(--color-accent);
    gap: 2rem;
  }

  .archive-link span:last-child {
    color: var(--color-accent);
  }

  @media (max-width: 639px) {
    .hero {
      padding: 3rem 0 1rem;
    }

    .hero-eyebrow {
      font-size: 0.5625rem;
      gap: 0.5rem;
    }

    .hero-title {
      font-size: clamp(4.2rem, 18vw, 7rem);
      margin-top: 1rem;
      margin-bottom: 1.25rem;
    }

    .hero-bottom {
      align-items: flex-start;
      gap: 1rem;
    }

    .hero-intro {
      font-size: clamp(1.25rem, 6vw, 1.75rem);
      max-width: 17rem;
    }

    .hero-note {
      max-width: 8.5rem;
      font-size: 0.75rem;
    }

    .section-heading {
      font-size: 0.5625rem;
      gap: 0.5rem;
    }

    .hero-rule {
      margin-top: 1.5rem;
      margin-bottom: 2rem;
    }

    .selected-work-grid {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .hero-title {
      font-size: clamp(3rem, 17vw, 4.5rem);
    }

    .dominant-col {
      width: 100%;
    }

    .support-col {
      width: 100%;
      gap: 0.75rem;
      padding-top: 0;
    }

    .support-items {
      display: grid;
      grid-template-columns: 1.12fr 0.88fr;
      gap: 1rem;
      align-items: start;
    }

    .featured-continuation {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      margin-top: 2.5rem;
    }

    .featured-card-4,
    .featured-card-5,
    .featured-card-6,
    .featured-card-7 {
      width: 100%;
      margin: 0;
    }

    .archive-section {
      margin-top: 3.5rem;
      margin-bottom: 2.5rem;
    }

    .archive-link-wrapper {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
