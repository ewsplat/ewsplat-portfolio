---
import Layout from '../../layouts/Layout.astro';
import MediaBlock from '../../components/MediaBlock.astro';
import { withBase } from '../../utils/site';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const sortedProjects = projects.sort((a, b) => a.id.localeCompare(b.id));
  const published = sortedProjects.filter((project) => !project.data.draft);
  const compositionTests = sortedProjects.filter((project) => project.data.compositionTest);
  const routes = [
    ...published.map((project, index) => ({ project, projectIndex: index + 1 })),
    ...compositionTests.map((project, index) => ({
      project,
      projectIndex: published.length + index + 1,
    })),
  ];
  const slugs = routes.map(({ project }) => project.data.slug ?? project.id);

  if (new Set(slugs).size !== slugs.length) {
    throw new Error('Project slugs must be unique.');
  }

  return routes.map(({ project, projectIndex }, index) => ({
    params: { slug: slugs[index] },
    props: { project, projectIndex },
  }));
}

const { project, projectIndex } = Astro.props;
const { data } = project;
const heroAspect = data.hero?.aspect?.split('/').map(Number);
const portraitHero = heroAspect && heroAspect[0] < heroAspect[1];
const portraitMaxWidth = portraitHero && heroAspect
  ? `${75 * heroAspect[0] / heroAspect[1]}svh`
  : undefined;
---

<Layout title={`${data.title} — EWSPLAT`} description={data.description ?? `${data.title} — EWSPLAT project.`}>
  <div class:list={['project-opening', 'container', `composition-${data.composition}`, { 'portrait-opening': portraitHero, 'no-hero': !data.hero }]}>
    {data.hero && (
      <section
        class="project-hero"
        aria-label="Project hero media"
        style={portraitMaxWidth ? `--portrait-width: min(100%, ${portraitMaxWidth});` : undefined}
      >
        <MediaBlock
          type={data.hero.type}
          src={data.hero.src}
          aspect={data.hero.aspect}
          color={data.hero.color}
          alt={data.hero.alt || data.title}
          poster={data.hero.poster}
          crop={data.hero.crop}
          loading="eager"
        />
      </section>
    )}

    <header class="project-header">
      <div class="project-kicker">
        <span>{data.placeholder ? 'Placeholder / visual study' : 'Selected project'}</span>
        {!data.compositionTest && <span aria-hidden="true">{String(projectIndex).padStart(2, '0')}</span>}
      </div>
      <h1 class="project-title">{data.title}</h1>
      {data.description && <p class="project-description">{data.description}</p>}
      {(data.year || data.client || data.roles.length > 0) && (
        <div class="project-meta">
          {data.year && <span class="project-year">{data.year}</span>}
          {data.client && <span class="project-client">{data.client}</span>}
          {data.roles.length > 0 && <span class="project-roles">{data.roles.join(' / ')}</span>}
        </div>
      )}
    </header>
  </div>

  <div class="container project-content">
    {(data.gallery.length > 0 || data.sections.length > 0 || data.credits.length > 0 || data.links.length > 0) && (
      <hr class="section-rule" />
    )}

    <!-- Gallery -->
    {data.gallery.length > 0 && (
      <section class="project-gallery" aria-label="Project gallery">
        <div class="gallery-grid">
          {data.gallery.map((item, i) => (
            <div class="gallery-item">
              <MediaBlock
                type={item.type}
                src={item.src}
                aspect={item.aspect}
                color={item.color}
                alt={item.alt || `${data.title} — image ${i + 1}`}
                poster={item.poster}
                crop={item.crop}
              />
              {item.caption && <p class="gallery-caption">{item.caption}</p>}
            </div>
          ))}
        </div>
      </section>
    )}

    {data.sections.length > 0 && (
      <section class="project-sections" aria-label="Project content">
        {data.sections.map((section) => (
          section.type === 'text' ? (
            <section class:list={['text-section', section.layout && `layout-${section.layout}`, section.alignment && `align-${section.alignment}`]}>
              {section.heading && <h2 class="section-heading">{section.heading}</h2>}
              <p>{section.body}</p>
            </section>
          ) : (
            <figure class:list={['media-section', `layout-${section.layout}`, `align-${section.alignment}`]}>
              <MediaBlock
                type={section.media.type}
                src={section.media.src}
                aspect={section.media.aspect}
                color={section.media.color}
                alt={section.media.alt || data.title}
                poster={section.media.poster}
                crop={section.media.crop}
              />
              {section.caption && <figcaption class="gallery-caption">{section.caption}</figcaption>}
            </figure>
          )
        ))}
      </section>
    )}

    <!-- Credits -->
    {data.credits.length > 0 && (
      <section class="project-credits" aria-label="Credits">
        <hr class="section-rule" />
        <h2 class="credits-heading">Credits</h2>
        <ul class="credits-list">
          {data.credits.map((credit) => (
            <li>
              <span class="credit-role">{credit.role}</span>
              <span class="credit-name">{credit.name}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Links -->
    {data.links.length > 0 && (
      <section class="project-links" aria-label="External links">
        <hr class="section-rule" />
        <ul class="links-list">
          {data.links.map((link) => (
            <li>
              <a href={withBase(link.url)} target="_blank" rel="noopener noreferrer" class="external-link">
                {link.label} ↗
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Back nav -->
    <nav class="project-nav" aria-label="Project navigation">
      <hr class="section-rule" />
      <a href={withBase('/archive')} class="back-link">← Archive</a>
    </nav>
  </div>
</Layout>

<style>
  .project-opening {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(18rem, 5fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: stretch;
    padding-top: clamp(2rem, 6vw, 5rem);
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .project-opening.portrait-opening {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }

  .project-opening.no-hero {
    grid-template-columns: minmax(0, 1fr);
  }

  .project-opening.no-hero .project-header {
    min-height: min(58svh, 36rem);
  }

  .project-opening.composition-single-artwork,
  .project-opening.composition-motion {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .project-opening.composition-single-artwork {
    padding-bottom: 2rem;
  }

  .composition-single-artwork .project-header,
  .composition-motion .project-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.42fr);
    align-items: end;
    column-gap: clamp(1.5rem, 5vw, 5rem);
    padding: 0;
  }

  .composition-motion .project-header {
    order: 0;
  }

  .composition-motion .project-hero {
    order: 1;
  }

  .composition-single-artwork .project-kicker,
  .composition-motion .project-kicker {
    grid-column: 1 / -1;
  }

  .composition-single-artwork .project-title,
  .composition-motion .project-title {
    grid-column: 1;
    font-size: clamp(3.5rem, 6.5vw, 5.5rem);
  }

  .composition-single-artwork .project-description,
  .composition-motion .project-description {
    grid-column: 1;
  }

  .composition-single-artwork .project-meta,
  .composition-motion .project-meta {
    grid-column: 2;
    grid-row: 2 / span 2;
    width: 100%;
    margin-top: 0;
  }

  .composition-single-artwork .project-hero :global(.media-block) {
    width: min(100%, 56rem);
    margin-inline: auto;
  }

  .composition-motion .project-hero :global(.media-block) {
    width: 100%;
  }

  .project-opening.composition-graphic-sequence {
    grid-template-columns: minmax(0, 1fr);
  }

  .project-opening.composition-graphic-sequence.no-hero .project-header {
    min-height: 0;
    padding: 2rem 0 3rem;
  }

  .project-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  .project-hero :global(.media-block) {
    max-width: 100%;
  }

  .portrait-opening .project-hero :global(.media-block) {
    width: var(--portrait-width);
    margin-inline: auto;
  }

  .project-header {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    min-width: 0;
    padding: 2rem 0;
  }

  .project-kicker {
    display: flex;
    justify-content: space-between;
    width: 100%;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-kicker span:last-child {
    color: var(--color-muted);
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    margin-top: 1.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .project-year,
  .project-client {
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .project-roles {
    flex-basis: 100%;
    font-family: var(--font-mono);
    color: var(--color-muted);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    line-height: 1.6;
  }

  .project-title {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 7.5vw, 7rem);
    line-height: 0.82;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
    color: var(--color-text);
  }

  .project-description {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.5;
    color: var(--color-muted);
    max-width: 34rem;
    margin-top: 1.25rem;
  }

  .project-content {
    padding-top: 1rem;
  }

  .section-rule {
    border: none;
    border-bottom: 1px solid var(--color-border);
    margin: 2rem 0;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2.5rem 1.5rem;
    margin-bottom: 3rem;
  }

  .gallery-item {
    grid-column: span 7;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .gallery-item:nth-child(even) {
    grid-column: span 5;
    align-self: center;
  }

  .gallery-caption {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }

  .project-sections {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 8vw, 7rem);
    margin-bottom: 3rem;
  }

  .media-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
  }

  .media-section.layout-half {
    width: min(58%, 44rem);
  }

  .media-section.layout-narrow {
    width: min(76%, 52rem);
  }

  .media-section.align-right {
    align-self: flex-end;
  }

  .text-section {
    max-width: 42rem;
    line-height: 1.7;
  }

  .text-section.layout-full {
    max-width: none;
    width: 100%;
  }

  .text-section.layout-half {
    max-width: 44rem;
    width: min(58%, 44rem);
  }

  .text-section.layout-narrow {
    max-width: 52rem;
    width: min(76%, 52rem);
  }

  .text-section.align-right {
    align-self: flex-end;
  }

  .section-heading {
    margin-bottom: 0.75rem;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
  }

  .text-section p {
    font-size: clamp(1rem, 1.8vw, 1.35rem);
    letter-spacing: -0.025em;
  }

  .credits-heading {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .credits-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .credits-list li {
    display: flex;
    gap: 1.5rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
  }

  .credit-role {
    color: var(--color-muted);
    min-width: 10rem;
  }

  .credit-name {
    color: var(--color-text);
  }

  .links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .external-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-accent);
  }

  .external-link:hover {
    text-decoration: underline;
  }

  .project-nav {
    margin-bottom: 4rem;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--color-text);
  }

  @media (max-width: 639px) {
    .project-opening,
    .project-opening.portrait-opening {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
      padding-top: 1.5rem;
      padding-bottom: 2rem;
    }

    .project-opening.no-hero .project-header {
      min-height: 0;
      padding-block: 4rem 2rem;
    }

    .project-opening.composition-single-artwork,
    .project-opening.composition-motion {
      gap: 1.5rem;
      padding-bottom: 2rem;
    }

    .composition-single-artwork .project-header,
    .composition-motion .project-header {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .composition-motion .project-header {
      order: 0;
    }

    .composition-motion .project-hero {
      order: 1;
    }

    .composition-single-artwork .project-title,
    .composition-motion .project-title {
      grid-column: 1;
      font-size: clamp(3rem, 13vw, 4.5rem);
    }

    .composition-single-artwork .project-meta,
    .composition-motion .project-meta {
      grid-column: 1;
      grid-row: auto;
      margin-top: 1rem;
    }

    .project-opening.composition-graphic-sequence.no-hero .project-header {
      padding: 1.5rem 0 2rem;
    }

    .project-hero {
      order: 0;
    }

    .project-hero :global(.media-block),
    .portrait-opening .project-hero :global(.media-block) {
      width: 100%;
      max-width: min(100%, 29rem);
    }

    .project-header {
      order: 1;
      padding: 0.75rem 0;
    }

    .project-title {
      font-size: clamp(3.5rem, 17vw, 5rem);
    }

    .gallery-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .gallery-item,
    .gallery-item:nth-child(even) {
      grid-column: 1;
    }

    .media-section.layout-half,
    .media-section.layout-narrow,
    .text-section.layout-half,
    .text-section.layout-narrow {
      width: 100%;
    }
  }
</style>
