---
import Layout from '../layouts/Layout.astro';
import MediaBlock from '../components/MediaBlock.astro';
import { withBase } from '../utils/site';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects
  .filter((p) => !p.data.draft && !p.data.compositionTest && !p.data.placeholder)
  .sort((a, b) => (a.data.archiveOrder ?? a.data.featuredOrder ?? 999) - (b.data.archiveOrder ?? b.data.featuredOrder ?? 999)
    || a.data.title.localeCompare(b.data.title));

const totalCount = projects.length;

// Derive mode from existing metadata (workType + collection)
const deriveMode = (project) => {
  const workType = project.data.workType;
  const collection = project.data.collection?.toLowerCase() || '';

  if (workType === 'client') return 'commissions';
  if (workType === 'personal') return 'personal';
  if (collection.includes('personal') || collection.includes('self')) return 'personal';
  return 'commissions';
};

const modeDerived = projects.map((p) => ({
  ...p,
  _mode: deriveMode(p),
}));

const commissionsProjects = modeDerived.filter((p) => p._mode === 'commissions');
const personalProjects = modeDerived.filter((p) => p._mode === 'personal');
const commissionsCount = commissionsProjects.length;
const personalCount = personalProjects.length;

// Count projects per discipline using the new discipline field
const disciplineCategories = [
  { id: 'animation-motion', label: 'Animation & Motion' },
  { id: 'illustration', label: 'Illustration' },
  { id: 'graphic-design', label: 'Graphic Design' },
  { id: 'campaigns-events', label: 'Campaigns & Events' },
  { id: 'character-design', label: 'Character Design' },
  { id: 'art-direction', label: 'Art Direction' },
  { id: 'visual-identity', label: 'Visual Identity' },
  { id: 'visual-experiments', label: 'Visual Experiments' },
  { id: 'mixed', label: 'Mixed' },
].map((category) => ({
  ...category,
  count: projects.filter((p) => p.data.discipline === category.id).length,
})).filter((c) => c.count > 0);

// Assign each project a grid size for modular layout based on featured status and discipline
interface ProjectWithSize {
  project: typeof modeDerived[0];
  gridSize: 'large' | 'medium' | 'small' | 'portrait' | 'square' | 'cinematic';
}

const projectsWithSize: ProjectWithSize[] = modeDerived.map((item, index) => {
  const project = item;
  const isFeatured = project.data.featured === true;
  const isVideo = project.data.thumbnail?.type === 'video' || project.data.thumbnail?.type === 'youtube';
  const discipline = project.data.discipline;

  let gridSize: ProjectWithSize['gridSize'] = 'medium';

  // Featured projects get priority for larger fragments
  if (isFeatured && project.data.thumbnail) {
    gridSize = isVideo ? 'cinematic' : 'large';
  }
  // Video content gets larger treatment for motion showcase
  else if (isVideo && project.data.thumbnail) {
    gridSize = 'large';
  }
  // Personal work thumbnails - varied for rhythm
  else if (project._mode === 'personal' && project.data.thumbnail) {
    const personalVariants: ProjectWithSize['gridSize'][] = ['medium', 'portrait', 'square', 'medium'];
    gridSize = personalVariants[index % personalVariants.length];
  }
  // Default thumbnail treatment
  else if (project.data.thumbnail) {
    const standardVariants: ProjectWithSize['gridSize'][] = ['medium', 'small', 'square', 'portrait'];
    gridSize = standardVariants[index % standardVariants.length];
  }

  return {
    project,
    gridSize,
  };
});
---

<Layout title="Archive — EWSPLAT" description="Complete archive of works, experiments, and visual projects.">
  <div class="container archive-container" data-archive>
    <!-- Archive Header -->
    <header class="archive-header">
      <div class="archive-top-data">
        <span class="technical-kicker">
          <span class="kicker-block" aria-hidden="true">■</span>
          Archive
        </span>
        <span class="archive-index-meta">{totalCount} projects</span>
      </div>

      <div class="archive-heading-row">
        <div>
          <h1 class="archive-heading">Archive<span class="heading-dot" aria-hidden="true">.</span></h1>
        </div>
        <div class="archive-register">
          <span class="register-label">Total projects</span>
          <span class="register-val">{totalCount.toString().padStart(2, '0')}</span>
        </div>
      </div>

      <p class="archive-intro">
        Commissioned work, character design and independent motion studies.
      </p>

      <hr class="header-rule" />
    </header>

    <!-- Filter Controls -->
    <nav class="archive-filters" aria-label="Filter archive projects by mode and discipline" data-archive-filters hidden>
      <!-- Mode Switcher (Client work vs Personal work) -->
      <div class="mode-control-block">
        <span class="control-label">Work type</span>
        <div class="mode-switcher" data-mode-switcher>
          <button class="mode-button" type="button" data-mode="all" aria-pressed="true">
            <span class="mode-label">All work</span>
            <span class="mode-count">{String(totalCount).padStart(2, '0')}</span>
          </button>
          <button
            class="mode-button"
            type="button"
            data-mode="commissions"
            aria-pressed="false"
          >
            <span class="mode-label">Client work</span>
            <span class="mode-count">{String(commissionsCount).padStart(2, '0')}</span>
          </button>
          <button
            class="mode-button"
            type="button"
            data-mode="personal"
            aria-pressed="false"
          >
            <span class="mode-label">Personal work</span>
            <span class="mode-count">{String(personalCount).padStart(2, '0')}</span>
          </button>
        </div>
      </div>

      <!-- Discipline Filter -->
      <div class="discipline-control-block">
        <span class="control-label">Discipline</span>
        <div class="filter-options" role="group" aria-label="Discipline categories">
          <button class="filter-button" type="button" data-filter="all" data-filter-group="discipline" aria-pressed="true">
            <span>All</span>
            <span class="count-pill">{String(totalCount).padStart(2, '0')}</span>
          </button>
          {disciplineCategories.map((category) => (
            <button class="filter-button" type="button" data-filter={category.id} data-filter-group="discipline" aria-pressed="false">
              <span>{category.label}</span>
              <span class="count-pill">{String(category.count).padStart(2, '0')}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="archive-status-bar">
        <p class="archive-results" data-archive-results role="status" aria-live="polite">
          <span data-result-copy>Showing all {totalCount} projects</span>
          <span class="filter-stamp" data-filter-stamp aria-hidden="true"></span>
        </p>
      </div>
    </nav>

    <p class="archive-empty" data-archive-empty hidden>No projects match the current filter selection.</p>

    <!-- Floating Project Metadata Tooltip -->
    <div class="project-tooltip" id="project-tooltip" aria-hidden="true" role="tooltip">
      <div class="tooltip-inner">
        <span class="tooltip-title" id="tooltip-title"></span>
        <span class="tooltip-category" id="tooltip-category"></span>
        <span class="tooltip-year" id="tooltip-year"></span>
      </div>
    </div>

    <!-- Archive Modular Grid - ONE ENTRY PER PROJECT -->
    <section class="archive-grid" aria-label="Projects in archive" data-archive-grid>
      {projectsWithSize.map((item, index) => {
        const project = item.project;
        const discipline = project.data.discipline || 'mixed';
        const workType = project.data.workType ?? 'client';
        const allCategoriesForProject = [workType, discipline];
        const year = project.data.year ?? ''; 
        const thumbnail = project.data.thumbnail;

        return (
          <article
            class:list={['archive-fragment', `fragment-${item.gridSize}`]}
            data-archive-item
            data-categories={allCategoriesForProject.join(' ')}
            data-mode={project._mode}
            data-project-title={project.data.title}
            data-project-category={discipline}
            data-project-year={year}
            data-project-index={index}
            data-layout={index % 6}
          >
            <a
              href={withBase(`/projects/${project.data.slug ?? project.id}`)}
              class="fragment-link"
              aria-label={`View ${project.data.title}`}
            >
              <div class="fragment-media">
                {thumbnail && (
                  <MediaBlock
                    type={thumbnail.type}
                    src={thumbnail.src}
                    aspect={thumbnail.aspect}
                    color={thumbnail.color}
                    alt={thumbnail.alt || project.data.title}
                    poster={thumbnail.poster}
                    videoId={thumbnail.videoId}
                    controls={false}
                    loading={index < 12 ? 'eager' : 'lazy'}
                  />
                )}
              </div>
              <div class="fragment-label" aria-hidden="true">
                <span class="fragment-label-title">{project.data.title}</span>
                <span class="fragment-label-meta">{discipline}{year ? ` · ${year}` : ''}</span>
              </div>
            </a>
          </article>
        );
      })}
    </section>
  </div>
</Layout>

<style>
  .archive-container {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  /* Header */
  .archive-header {
    margin-bottom: clamp(1rem, 2.5vw, 1.75rem);
  }

  .archive-top-data {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1rem;
  }

  .technical-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-accent);
    font-weight: 500;
  }

  .kicker-block {
    font-size: 0.5rem;
  }

  .archive-heading-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .archive-heading {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.85;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .heading-dot {
    color: var(--color-accent);
  }

  .archive-register {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-family: var(--font-mono);
  }

  .register-label {
    font-size: 0.5625rem;
    color: var(--color-muted);
    letter-spacing: 0.08em;
  }

  .register-val {
    font-size: clamp(1.5rem, 3.5vw, 2.75rem);
    font-weight: 600;
    line-height: 1;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .archive-intro {
    margin-top: 0.75rem;
    font-family: var(--font-body);
    font-size: clamp(0.9rem, 1.4vw, 1.1rem);
    color: var(--color-text);
    max-width: 48ch;
    line-height: 1.5;
  }

  .header-rule {
    border: none;
    border-bottom: 1px solid var(--color-border);
    margin-top: clamp(1rem, 2.5vw, 1.5rem);
  }

  /* Filter Apparatus */
  .archive-filters {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .control-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin-bottom: 0.35rem;
  }

  .mode-switcher {
    display: inline-flex;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg);
    width: 100%;
    max-width: 26rem;
  }

  .mode-button {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.5rem 0.75rem;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.16s ease, color 0.16s ease;
  }

  .mode-button:first-child {
    border-right: 1px solid var(--color-border);
  }

  .mode-button[aria-pressed='true'] {
    background-color: var(--color-text);
    color: var(--color-surface-pure);
  }

  .mode-button[aria-pressed='true'] .mode-count {
    color: var(--color-accent);
  }

  .mode-button:hover:not([aria-pressed='true']) {
    color: var(--color-text);
    background-color: var(--color-surface-hover);
  }

  .mode-count {
    font-size: 0.55rem;
    font-weight: 600;
  }

  .filter-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .filter-button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }

  .filter-button:hover {
    border-color: var(--color-text);
    color: var(--color-text);
  }

  .filter-button[aria-pressed='true'] {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: #FFFFFF;
  }

  .filter-button[aria-pressed='true'] .count-pill {
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.2);
  }

  .count-pill {
    font-size: 0.55rem;
    padding: 0.05rem 0.2rem;
    background-color: var(--color-surface);
    color: var(--color-muted);
  }

  .archive-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.6rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-muted);
  }

  .filter-stamp {
    display: inline-block;
    width: 5px;
    height: 5px;
    background-color: var(--color-accent);
    margin-left: 0.3rem;
  }

  .archive-empty {
    padding: 3rem 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    text-transform: uppercase;
    text-align: center;
  }

  /* Floating Project Metadata Tooltip */
  .project-tooltip {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 100;
    transform: translate(-50%, -100%);
    opacity: 0;
    transition: opacity 180ms cubic-bezier(0.2, 0.65, 0.3, 1), transform 180ms cubic-bezier(0.2, 0.65, 0.3, 1);
    will-change: transform, opacity;
  }

  .project-tooltip.visible {
    opacity: 1;
  }

  .tooltip-inner {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.5rem 0.75rem;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.35);
    transition: opacity 120ms ease, transform 120ms ease;
  }

  .project-tooltip.is-changing .tooltip-inner {
    opacity: 0.35;
    transform: translateY(3px);
  }

  .tooltip-title {
    color: var(--color-text);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .tooltip-category {
    color: var(--color-accent);
    text-transform: uppercase;
  }

  .tooltip-year {
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-tooltip {
      transition: none;
    }

    .tooltip-inner {
      transition: none;
    }
  }

  /* Archive Modular Grid */
  .archive-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    grid-auto-flow: dense;
  }

  /* Fragment Base */
  .archive-fragment {
    position: relative;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    overflow: hidden;
    transition: border-color 0.16s ease, box-shadow 0.16s ease;
  }

  .archive-fragment:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 16px -4px rgba(0, 0, 0, 0.2);
  }

  .fragment-link {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .fragment-media {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .fragment-media :global(.media-block) {
    background: transparent;
    width: 100%;
    height: 100%;
  }

  .fragment-media :global(.media-block img),
  .fragment-media :global(.media-block video),
  .fragment-media :global(.media-block iframe) {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }

  .fragment-label {
    display: none;
  }

  /* Grid Sizes - 12 column modular system */
  .fragment-large {
    grid-column: span 8;
    aspect-ratio: 16 / 9;
  }

  .fragment-cinematic {
    grid-column: span 8;
    aspect-ratio: 21 / 9;
  }

  .fragment-medium {
    grid-column: span 6;
    aspect-ratio: 4 / 3;
  }

  .fragment-small {
    grid-column: span 4;
    aspect-ratio: 1 / 1;
  }

  .fragment-portrait {
    grid-column: span 4;
    aspect-ratio: 3 / 4;
  }

  .fragment-square {
    grid-column: span 6;
    aspect-ratio: 1 / 1;
  }

  @media (min-width: 901px) {
    .archive-fragment[data-layout='0'] { grid-column: 1 / span 7; }
    .archive-fragment[data-layout='1'] { grid-column: 7 / span 6; }
    .archive-fragment[data-layout='2'] { grid-column: 2 / span 5; }
    .archive-fragment[data-layout='3'] { grid-column: 8 / span 5; }
    .archive-fragment[data-layout='4'] { grid-column: 1 / span 4; }
    .archive-fragment[data-layout='5'] { grid-column: 6 / span 7; }
  }

  /* Reduced motion - disable hover transforms */
  @media (prefers-reduced-motion: reduce) {
    .archive-fragment:hover {
      box-shadow: none;
    }
  }

  /* Touch devices - no hover states */
  @media (hover: none) {
    .archive-fragment:hover {
      border-color: var(--color-border);
      box-shadow: none;
    }

    .archive-fragment:active {
      border-color: var(--color-accent);
    }
  }

  /* Mobile / Tablet - Single column flow */
  @media (max-width: 900px) {
    .archive-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: clamp(0.5rem, 1.2vw, 1rem);
    }

    .fragment-large,
    .fragment-cinematic,
    .fragment-medium,
    .fragment-small,
    .fragment-portrait,
    .fragment-square {
      grid-column: 1 / -1;
    }

    .fragment-large { aspect-ratio: 16 / 9; }
    .fragment-cinematic { aspect-ratio: 21 / 9; }
    .fragment-medium { aspect-ratio: 4 / 3; }
    .fragment-small { aspect-ratio: 1 / 1; }
    .fragment-portrait { aspect-ratio: 3 / 4; }
    .fragment-square { aspect-ratio: 1 / 1; }
  }

  /* Mobile - Stack vertically, larger media */
  @media (max-width: 640px) {
    .archive-container {
      padding-top: 1.25rem;
      padding-bottom: 2rem;
    }

    .archive-top-data {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }

    .archive-heading-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .archive-register {
      align-items: flex-start;
    }

    .archive-heading {
      font-size: clamp(2.5rem, 12vw, 4rem);
    }

    .register-val {
      font-size: clamp(1.25rem, 6vw, 2rem);
    }

    .archive-filters {
      padding: 0.75rem 1rem;
      margin-bottom: 1.25rem;
    }

    .mode-switcher {
      max-width: 100%;
    }

    .filter-options {
      gap: 0.35rem;
    }

    .filter-button {
      padding: 0.25rem 0.5rem;
      font-size: 0.5625rem;
    }

    .archive-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .archive-fragment {
      aspect-ratio: 16 / 9 !important;
    }

    .project-tooltip {
      display: none;
    }

    .fragment-label {
      display: grid;
      gap: 0.25rem;
      padding: 0.65rem 0.75rem 0.7rem;
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
    }

    .fragment-label-title {
      font-family: var(--font-headline);
      font-size: 0.95rem;
      line-height: 1.05;
    }

    .fragment-label-meta {
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: 0.5625rem;
      letter-spacing: 0.07em;
      text-transform: uppercase;
    }
  }
</style>

<script>
  function setupArchiveFilters() {
    const archive = document.querySelector<HTMLElement>('[data-archive]');
    if (!archive || archive.dataset.filtersReady === 'true') return;

    const filterNav = archive.querySelector<HTMLElement>('[data-archive-filters]');
    const buttons = Array.from(archive.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const items = Array.from(archive.querySelectorAll<HTMLElement>('[data-archive-item]'));
    const resultCopy = archive.querySelector<HTMLElement>('[data-result-copy]');
    const stamp = archive.querySelector<HTMLElement>('[data-filter-stamp]');
    const emptyState = archive.querySelector<HTMLElement>('[data-archive-empty]');

    if (!filterNav || !resultCopy || !stamp || !emptyState || buttons.length === 0 || items.length === 0) {
      return;
    }

    archive.dataset.filtersReady = 'true';
    filterNav.hidden = false;

    let activeDiscipline = 'all';
    let activeMode = 'all';

    // Mode switcher functionality
    const modeSwitcher = document.querySelector<HTMLElement>('[data-mode-switcher]');
    if (modeSwitcher) {
      const modeButtons = Array.from(modeSwitcher.querySelectorAll<HTMLButtonElement>('.mode-button'));

      modeButtons.forEach((button) => {
        button.addEventListener('click', () => {
          modeButtons.forEach((btn) => btn.setAttribute('aria-pressed', 'false'));
          button.setAttribute('aria-pressed', 'true');

          activeMode = button.getAttribute('data-mode') ?? 'all';
          activeDiscipline = 'all';
          applyFilters();
        });
      });
    }

    const applyFilters = () => {
      let visibleCount = 0;
      items.forEach((item) => {
        const categories = item.dataset.categories?.split(' ') ?? [];
        const projectMode = item.dataset.mode ?? 'commissions';

        const matchesMode = activeMode === 'all' || projectMode === activeMode;
        const matchesDiscipline = activeDiscipline === 'all' || categories.includes(activeDiscipline);

        const isVisible = matchesMode && matchesDiscipline;
        item.hidden = !isVisible;
        if (isVisible) visibleCount++;
      });

      // Update button states
      buttons.forEach((button) => {
        const group = button.dataset.filterGroup;
        const filter = button.dataset.filter ?? 'all';
        const isActive = group === 'discipline' ? filter === activeDiscipline : false;
        button.setAttribute('aria-pressed', String(isActive));
      });

      // Update results status
      const modeLabel = activeMode === 'all' ? 'All Work' : activeMode === 'personal' ? 'Personal Experiments' : 'Commissions';
      resultCopy.textContent = `Showing ${visibleCount} items in ${modeLabel}${activeDiscipline !== 'all' ? ` (${activeDiscipline})` : ''}`;
      emptyState.hidden = visibleCount > 0;
    };

    // Filter navigation click handler
    filterNav.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest<HTMLButtonElement>('[data-filter]');
      if (button && filterNav.contains(button)) {
        const group = button.dataset.filterGroup;
        const filter = button.dataset.filter ?? 'all';

        if (group === 'discipline') {
          activeDiscipline = filter;
          applyFilters();
        }
      }
    });

    // Initial run
    applyFilters();
  }

  function setupProjectTooltip() {
    const tooltip = document.getElementById('project-tooltip');
    const titleEl = document.getElementById('tooltip-title');
    const categoryEl = document.getElementById('tooltip-category');
    const yearEl = document.getElementById('tooltip-year');

    if (!tooltip || !titleEl || !categoryEl || !yearEl) return;

    const items = document.querySelectorAll<HTMLElement>('[data-archive-item]');
    if (items.length === 0) return;

    let currentItem: HTMLElement | null = null;
    let tooltipVisible = false;
    let animationFrame = 0;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isTouch = window.matchMedia('(hover: none), (pointer: coarse)').matches;

    if (isTouch) {
      tooltip.style.display = 'none';
      return;
    }

    const updateTooltipPosition = () => {
      if (!tooltipVisible || !currentItem) return;

      const rect = currentItem.getBoundingClientRect();
      const tooltipRect = tooltip.getBoundingClientRect();

      // Position tooltip near the item, avoiding edges
      const viewportWidth = window.innerWidth;
      const viewportHeight = window.innerHeight;
      const tooltipWidth = tooltipRect.width;
      const tooltipHeight = tooltipRect.height;

      let x = rect.left + rect.width / 2;
      let y = rect.top - 12; // 12px above the item

      // Horizontal bounds
      if (x - tooltipWidth / 2 < 12) x = 12 + tooltipWidth / 2;
      if (x + tooltipWidth / 2 > viewportWidth - 12) x = viewportWidth - 12 - tooltipWidth / 2;

      // Vertical bounds - if too close to top, show below
      if (y - tooltipHeight < 12) {
        y = rect.bottom + 12;
      }

      targetX = x;
      targetY = y;

      if (reducedMotion) {
        currentX = targetX;
        currentY = targetY;
        tooltip.style.transform = `translate(${currentX - tooltipWidth / 2}px, ${currentY - tooltipHeight}px)`;
      } else {
        // Smooth interpolation
        currentX += (targetX - currentX) * 0.18;
        currentY += (targetY - currentY) * 0.18;
        tooltip.style.transform = `translate(${currentX - tooltipWidth / 2}px, ${currentY - tooltipHeight}px)`;
        animationFrame = requestAnimationFrame(updateTooltipPosition);
      }
    };

    const showTooltip = (item: HTMLElement) => {
      currentItem = item;
      tooltip.classList.add('is-changing');
      titleEl.textContent = item.dataset.projectTitle || '';
      categoryEl.textContent = item.dataset.projectCategory || '';
      yearEl.textContent = item.dataset.projectYear || '';

      tooltip.classList.add('visible');
      tooltipVisible = true;

      requestAnimationFrame(() => tooltip.classList.remove('is-changing'));

      if (!reducedMotion) {
        updateTooltipPosition();
      } else {
        updateTooltipPosition();
      }
    };

    const hideTooltip = () => {
      tooltip.classList.remove('visible');
      tooltipVisible = false;
      currentItem = null;
      if (animationFrame) {
        cancelAnimationFrame(animationFrame);
        animationFrame = 0;
      }
    };

    items.forEach((item) => {
      item.addEventListener('mouseenter', () => {
        if (!item.hidden) {
          showTooltip(item);
        }
      });

      item.addEventListener('mouseleave', () => {
        if (currentItem === item) {
          hideTooltip();
        }
      });

      item.addEventListener('focusin', () => {
        if (!item.hidden) {
          showTooltip(item);
        }
      });

      item.addEventListener('focusout', () => {
        if (currentItem === item) {
          hideTooltip();
        }
      });
    });

    // Handle filter changes - hide tooltip if current item becomes hidden
    const observer = new MutationObserver(() => {
      if (currentItem && currentItem.hidden) {
        hideTooltip();
      }
    });

    items.forEach((item) => {
      observer.observe(item, { attributes: true, attributeFilter: ['hidden'] });
    });
  }

  setupArchiveFilters();
  setupProjectTooltip();
  document.addEventListener('astro:page-load', () => {
    setupArchiveFilters();
    setupProjectTooltip();
  });
</script>
