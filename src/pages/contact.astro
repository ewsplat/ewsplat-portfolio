---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — EWSPLAT" description="Get in touch with EWSPLAT.">
  <div class="container">
    <header class="page-header">
      <h1 class="page-title">Contact</h1>
    </header>

    <div class="contact-content">
      <p class="contact-prompt">For project enquiries, collaborations and commissions.</p>

      <div class="placeholder-block" aria-label="Contact details placeholder">
        <p class="placeholder-label">[ Placeholder — add contact details, email link or inquiry form here ]</p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-header {
    padding: 4rem 0 2rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 3rem;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: 0.03em;
    color: var(--color-text);
  }

  .contact-content {
    max-width: 40rem;
    margin-bottom: 8rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .contact-prompt {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .placeholder-block {
    padding: 3rem 2rem;
    border: 1px dashed var(--color-border);
    border-radius: 2px;
    text-align: center;
  }

  .placeholder-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  @media (max-width: 639px) {
    .page-header {
      padding: 2.5rem 0 1.5rem;
      margin-bottom: 2rem;
    }
  }
</style>
