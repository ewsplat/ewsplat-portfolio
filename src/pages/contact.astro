---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — EWSPLAT" description="Get in touch with EWSPLAT — Nic Little, independent creative practice in Wellington.">
  <div class="container contact-container">
    <header class="contact-header">
      <p class="page-kicker">EWSPLAT / Contact</p>
      <h1 class="page-title">Have something in mind<span aria-hidden="true">?</span></h1>
      <hr class="header-rule" />
    </header>

    <section class="contact-content" aria-label="Contact information">
      <p class="contact-prompt">Projects / collaborations / commissions.</p>
      <div class="contact-note">
        <span class="note-label">Email</span>
        <p><a href="mailto:nic@ewsplat.com" class="contact-email">nic@ewsplat.com</a></p>
      </div>
      <div class="contact-note">
        <span class="note-label">Location</span>
        <p>Wellington, New Zealand</p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .contact-container {
    padding-top: clamp(3rem, 8vw, 7rem);
    padding-bottom: clamp(7rem, 20vw, 15rem);
  }

  .page-kicker,
  .note-label {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .page-title {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(5rem, 12vw, 9.5rem);
    line-height: 0.78;
    letter-spacing: -0.035em;
  }

  .page-title span {
    color: var(--color-accent);
  }

  .header-rule {
    border: none;
    border-bottom: 1px solid var(--color-accent);
    margin-top: 2rem;
  }

  .contact-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.7fr);
    align-items: start;
    gap: clamp(2rem, 9vw, 8rem);
    margin-top: clamp(3rem, 8vw, 7rem);
  }

  .contact-prompt {
    max-width: 32rem;
    font-size: clamp(1.35rem, 2.6vw, 2rem);
    letter-spacing: -0.04em;
    line-height: 1.35;
  }

  .contact-note {
    border-top: 1px solid var(--color-border);
    padding-top: 0.75rem;
    margin-top: 2rem;
  }

  .contact-note:first-of-type {
    margin-top: 0;
    border-top: none;
    padding-top: 0;
  }

  .note-label {
    display: block;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .contact-note p {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1.5;
  }

  .contact-email {
    color: var(--color-text);
    transition: color 0.15s ease;
  }

  .contact-email:hover,
  .contact-email:focus-visible {
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .contact-content {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 639px) {
    .contact-container {
      padding-top: 2.5rem;
      padding-bottom: 7rem;
    }

    .page-kicker,
    .note-label {
      font-size: 0.5625rem;
    }

    .page-title {
      font-size: clamp(4.5rem, 22vw, 6.5rem);
    }
  }
</style>
