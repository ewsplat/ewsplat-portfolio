---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/site';
import { getCollection } from 'astro:content';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  socialImage?: string;
}

const { title = 'EWSPLAT', description = 'Independent creative practice - illustration, animation, graphic design and visual experiments.', type = 'website', socialImage } = Astro.props;
const projectSlug = Astro.url.pathname.match(/^\/projects\/([^/]+)/)?.[1];
const project = projectSlug ? (await getCollection('projects')).find((item) => (item.data.slug ?? item.id) === projectSlug) : undefined;
const resolvedSocialImage = socialImage ?? project?.data.thumbnail?.src ?? project?.data.hero?.src;
const siteOrigin = Astro.site?.toString().replace(/\/$/, '');
const canonicalUrl = siteOrigin ? new URL(Astro.url.pathname, `${siteOrigin}/`).toString() : undefined;
const absoluteSocialImage = resolvedSocialImage ? (/^(?:https?:)?\/\//i.test(resolvedSocialImage) ? resolvedSocialImage : siteOrigin ? new URL(withBase(resolvedSocialImage), `${siteOrigin}/`).toString() : undefined) : undefined;
const jsonLd = { '@context': 'https://schema.org', '@type': type === 'article' ? 'CreativeWork' : 'WebPage', name: title, description, ...(canonicalUrl ? { url: canonicalUrl } : {}), ...(absoluteSocialImage ? { image: absoluteSocialImage } : {}), creator: { '@type': 'Person', name: 'Nic Little' } };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:site_name" content="EWSPLAT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {absoluteSocialImage && <meta property="og:image" content={absoluteSocialImage} />}
    <meta name="twitter:card" content={absoluteSocialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteSocialImage && <meta name="twitter:image" content={absoluteSocialImage} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Nav />
    <main id="main-content"><slot /></main>
    <Footer />
    <script>
      import '../scripts/interactions';
    </script>
  </body>
</html>
